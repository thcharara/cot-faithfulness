# Copy this file to `.env` and fill in real values.
# `.env` is gitignored.

# Anthropic API key — required for the Study 1 auto-coding pipeline
# (`study1_corpus/scripts/study1_batch_code_traces.py`).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Hugging Face token — only needed if `download_model.py` is pulling a gated
# checkpoint. The default DeepSeek-R1-Distill-Llama-8B model is public and
# does not require a token.
# HF_TOKEN=
